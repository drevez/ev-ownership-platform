NEXT_PUBLIC_GTM_ID=GTM-MG49P4DS
# Optional future server-side GTM endpoint, for example:
# NEXT_PUBLIC_GTM_SCRIPT_URL=https://gtm.yourdomain.com/gtm.js

# Optional product analytics. PostHog loads only after analytics consent.
# Leave empty to disable PostHog completely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Server-only credentials protecting /internal/* and /api/internal/*.
# Configure both in Vercel Preview and Production. Never prefix with NEXT_PUBLIC_.
INTERNAL_AUTH_USERNAME=replace-with-private-username
INTERNAL_AUTH_PASSWORD=replace-with-a-long-random-password

# Optional page feedback persistence webhook.
# Can point to Google Apps Script, Supabase Edge Function, or another private endpoint.
# The endpoint should accept POST feedback events and may return:
# { "stats": { "helpfulCount": 12, "notHelpfulCount": 3, "totalCount": 15 } }
FEEDBACK_WEBHOOK_URL=
FEEDBACK_WEBHOOK_SECRET=

# Optional missing-vehicle suggestion persistence webhook.
# Used when users search for a vehicle/model that does not exist yet.
VEHICLE_SUGGESTIONS_WEBHOOK_URL=
VEHICLE_SUGGESTIONS_WEBHOOK_SECRET=
