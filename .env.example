NEXT_PUBLIC_GTM_ID=GTM-MG49P4DS
# Optional future server-side GTM endpoint, for example:
# NEXT_PUBLIC_GTM_SCRIPT_URL=https://gtm.yourdomain.com/gtm.js

# Server-only credentials protecting /internal/* and /api/internal/*.
# Configure both in Vercel Preview and Production. Never prefix with NEXT_PUBLIC_.
INTERNAL_AUTH_USERNAME=replace-with-private-username
INTERNAL_AUTH_PASSWORD=replace-with-a-long-random-password
